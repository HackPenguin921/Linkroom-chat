rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 3つの公開チャンネル。匿名認証済みの人同士で共有します。
    match /rooms/{roomId}/messages/{messageId} {
      function validRoom() {
        return roomId in ['general', 'vrchat', 'gaming'];
      }
      function signedIn() {
        return request.auth != null;
      }
      allow read: if signedIn() && validRoom();
      allow create: if signedIn() && validRoom()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'name', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 24
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && validRoom()
        && resource.data.uid == request.auth.uid;
    }
    // 上記以外の読み書きは許可しません。
  }
}
