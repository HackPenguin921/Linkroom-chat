rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Random, unguessable 24-character invite code doubles as the room document ID.
    function goodCode(code) { return code.matches('^[A-HJ-NP-Z2-9]{24}$'); }
    function roomPath(code) { return /databases/$(database)/documents/rooms/$(code); }
    function filePath(code, fileId) { return /databases/$(database)/documents/rooms/$(code)/files/$(fileId); }
    function messagePath(code, messageId) { return /databases/$(database)/documents/rooms/$(code)/messages/$(messageId); }
    function member(code) {
      return signedIn() && exists(/databases/$(database)/documents/rooms/$(code)/members/$(request.auth.uid));
    }
    function validMime(m) {
      return m in [
        'image/png','image/jpeg','image/webp','image/gif','application/pdf',
        'text/plain','text/csv','application/zip',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
        'application/vnd.openxmlformats-officedocument.presentationml.presentation'
      ];
    }
    function validFile(f, roomId, messageId) {
      return f is map
        && f.keys().hasOnly(['kind','name','mime','bytes','data','path','fileId','chunks'])
        && f.keys().hasAll(['kind','name','mime','bytes'])
        && f.name is string && f.name.size() >= 1 && f.name.size() <= 120
        && f.mime is string && validMime(f.mime)
        && f.bytes is int && f.bytes > 0
        && (
          (f.kind == 'inline' && f.keys().hasAll(['data'])
            && f.bytes <= 262144 && f.data is string
            && f.data.size() <= 350000 && !('path' in f) && !('fileId' in f) && !('chunks' in f))
          ||
          (f.kind == 'storage' && f.keys().hasAll(['path'])
            && f.bytes <= 8388608 && f.path is string
            && f.path.matches('^rooms/' + roomId + '/' + messageId + '/[A-HJ-NP-Z2-9]{24}$')
            && !('data' in f) && !('fileId' in f) && !('chunks' in f))
          ||
          (f.kind == 'chunks' && f.keys().hasAll(['fileId','chunks'])
            && !('data' in f) && !('path' in f)
            && f.bytes <= 3145728
            && f.fileId is string && goodCode(f.fileId)
            && f.chunks is int && f.chunks >= 1 && f.chunks <= 32
            && exists(filePath(roomId, f.fileId))
            && get(filePath(roomId, f.fileId)).data.uid == request.auth.uid
            && get(filePath(roomId, f.fileId)).data.ready == true
            && get(filePath(roomId, f.fileId)).data.name == f.name
            && get(filePath(roomId, f.fileId)).data.mime == f.mime
            && get(filePath(roomId, f.fileId)).data.bytes == f.bytes
            && get(filePath(roomId, f.fileId)).data.chunks == f.chunks)
        );
    }
    function goodEmoji(e) { return e in ['👍','❤️','😂','😮','🎉','👀']; }
    match /rooms/{roomId} {
      // 'get' requires knowing the secret document ID. 'list' is ALWAYS denied.
      allow get: if signedIn() && goodCode(roomId);
      allow list: if false;
      allow create: if signedIn() && goodCode(roomId)
        && request.resource.data.keys().hasOnly(['title','ownerUid','createdAt'])
        && request.resource.data.keys().hasAll(['title','ownerUid','createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 60
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;

      match /members/{uid} {
        allow get: if signedIn() && uid == request.auth.uid;
        allow list: if false;
        // Possession of the secret code (the roomId) is the invitation.
        allow create: if signedIn() && uid == request.auth.uid && goodCode(roomId)
          && exists(roomPath(roomId))
          && request.resource.data.keys().hasOnly(['name','joinedAt'])
          && request.resource.data.keys().hasAll(['name','joinedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 24
          && request.resource.data.joinedAt == request.time;
        allow update, delete: if false;
      }

      match /messages/{messageId} {
        allow get, list: if member(roomId);
        allow create: if member(roomId)
          && request.resource.data.keys().hasOnly(['uid','name','text','createdAt','file'])
          && request.resource.data.keys().hasAll(['uid','name','text','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 24
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (request.resource.data.text.size() > 0 || 'file' in request.resource.data)
          && request.resource.data.createdAt == request.time
          && (!('file' in request.resource.data) || validFile(request.resource.data.file, roomId, messageId));
        allow update: if false;
        allow delete: if member(roomId) && resource.data.uid == request.auth.uid;
      }

      // Attachment blobs larger than 256 KiB are split into small Firestore documents.
      // This works on Spark (without Cloud Storage billing).
      match /files/{fileId} {
        allow get: if member(roomId);
        allow list: if false;
        allow create: if member(roomId) && goodCode(fileId)
          && request.resource.data.keys().hasOnly(['uid','name','mime','bytes','chunks','ready','createdAt'])
          && request.resource.data.keys().hasAll(['uid','name','mime','bytes','chunks','ready','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 120
          && request.resource.data.mime is string && validMime(request.resource.data.mime)
          && request.resource.data.bytes is int
          && request.resource.data.bytes > 262144 && request.resource.data.bytes <= 3145728
          && request.resource.data.chunks is int
          && request.resource.data.chunks >= 1 && request.resource.data.chunks <= 32
          && request.resource.data.ready == false
          && request.resource.data.createdAt == request.time;
        allow update: if member(roomId) && resource.data.uid == request.auth.uid
          && resource.data.ready == false && request.resource.data.ready == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ready']);
        allow delete: if member(roomId) && resource.data.uid == request.auth.uid;
        match /chunks/{chunkId} {
          allow get, list: if member(roomId);
          allow create: if member(roomId) && chunkId.matches('^00([012][0-9]|3[01])$')
            && exists(filePath(roomId, fileId))
            && get(filePath(roomId, fileId)).data.uid == request.auth.uid
            && get(filePath(roomId, fileId)).data.ready == false
            && request.resource.data.keys().hasOnly(['index','data'])
            && request.resource.data.keys().hasAll(['index','data'])
            && request.resource.data.index is int
            && request.resource.data.index >= 0
            && request.resource.data.index < get(filePath(roomId, fileId)).data.chunks
            && request.resource.data.data is string
            && request.resource.data.data.size() > 0
            && request.resource.data.data.size() <= 131072;
          allow update: if false;
          allow delete: if member(roomId) && exists(filePath(roomId, fileId))
            && get(filePath(roomId, fileId)).data.uid == request.auth.uid;
        }
      }

      match /reactions/{reactionId} {
        allow get, list: if member(roomId);
        allow create: if member(roomId)
          && request.resource.data.keys().hasOnly(['uid','messageId','emoji','createdAt'])
          && request.resource.data.keys().hasAll(['uid','messageId','emoji','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.messageId is string
          && request.resource.data.messageId.matches('^[A-Za-z0-9]{20}$')
          && reactionId == request.resource.data.messageId + '_' + request.auth.uid
          && exists(messagePath(roomId, request.resource.data.messageId))
          && goodEmoji(request.resource.data.emoji)
          && request.resource.data.createdAt == request.time;
        allow update: if member(roomId)
          && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emoji'])
          && goodEmoji(request.resource.data.emoji);
        // Message owners can remove reactions while deleting their own message.
        allow delete: if member(roomId) && (
          resource.data.uid == request.auth.uid ||
          (exists(messagePath(roomId, resource.data.messageId))
            && get(messagePath(roomId, resource.data.messageId)).data.uid == request.auth.uid)
        );
      }
    }
    // Deny everything not explicitly allowed above, including legacy public channels.
  }
}
